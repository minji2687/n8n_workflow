    {
      "id": "a302475d-a94d-454c-8ac7-1f1dac848f45",
      "name": "GitHub 페이로드 준비",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const wf = $input.item.json;\nconst path = `workflows/${wf.id}/workflow.json`;\nconst exportObj = {\n  name: wf.name,\n  nodes: wf.nodes,\n  connections: wf.connections,\n  settings: wf.settings,\n  active: wf.active,\n  id: wf.id\n};\nconst content = JSON.stringify(exportObj, null, 2);\nconst contentBase64 = Buffer.from(content, 'utf-8').toString('base64');\n\nreturn {\n  json: {\n    id: wf.id,\n    name: wf.name,\n    path,\n    contentBase64,\n    commitMessage: `Automated backup: ${wf.name} (${new Date().toISOString()})`\n  }\n};"
      }
    },
    {
      "id": "59e8ca2a-b99a-4cf7-bf79-ba0b640db16e",
      "name": "기존 SHA 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "url": "=https://api.github.com/repos/minji2687/n8n_workflow/contents/{{ $json.path }}",
        "method": "GET",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "yo3KCnXk8pRZ7xTY",
          "name": "GitHub PAT (Authorization Header)"
        }
      }
    },
    {
      "id": "c5300b49-d517-47b1-9d01-74b55e8ce1cd",
      "name": "SHA 병합",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prep = $('GitHub 페이로드 준비').item.json;\nconst shaLookup = $input.item.json;\nconst sha = shaLookup && shaLookup.sha ? shaLookup.sha : undefined;\n\nconst body = {\n  message: prep.commitMessage,\n  content: prep.contentBase64\n};\nif (sha) body.sha = sha;\n\nreturn { json: { path: prep.path, body } };"
      }
    },
    {
      "id": "bc80dc02-cd82-4de1-a872-4b950db40b9",
      "name": "GitHub Push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "url": "=https://api.github.com/repos/minji2687/n8n_workflow/contents/{{ $json.path }}",
        "method": "PUT",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 500
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "yo3KCnXk8pRZ7xTY",
          "name": "GitHub PAT (Authorization Header)"
        }
      },
      "onError": "continueRegularOutput"
    },
