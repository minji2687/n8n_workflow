      "id": "e98b1170-72c3-4720-b086-1eeefd01ca2f",
      "name": "이번 주 일정 조회",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        464,
        304
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "u2770RLspOyLjxHg",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst events = items.map(item => {\n  const ev = item.json;\n  const startRaw = ev.start?.dateTime || ev.start?.date;\n  return {\n    startRaw,\n    allDay: !ev.start?.dateTime,\n    summary: ev.summary || '(제목 없음)'\n  };\n}).filter(ev => ev.startRaw);\n\nevents.sort((a, b) => new Date(a.startRaw) - new Date(b.startRaw));\n\nif (events.length === 0) {\n  return [{ json: { text: ':calendar: *이번 주 일정*\\n등록된 일정이 없습니다.' } }];\n}\n\nconst lines = events.map(ev => {\n  const dt = DateTime.fromISO(ev.startRaw).setZone('Asia/Seoul');\n  const dateStr = ev.allDay ? dt.toFormat('MM/dd(ccc) 종일') : dt.toFormat('MM/dd(ccc) HH:mm');\n  return `• *${dateStr}* ${ev.summary}`;\n});\n\nconst text = `:calendar: *이번 주 일정 (${events.length}건)*\\n${lines.join('\\n')}`;\n\nreturn [{ json: { text } }];"
      },
