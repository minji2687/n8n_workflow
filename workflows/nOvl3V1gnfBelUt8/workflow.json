      "name": "메시지 포맷",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "const weatherCodeMap = {\n  0: '맑음', 1: '대체로 맑음', 2: '부분적으로 흐림', 3: '흐림',\n  45: '안개', 48: '서리 안개',\n  51: '가벼운 이슬비', 53: '이슬비', 55: '강한 이슬비',\n  61: '가벼운 비', 63: '비', 65: '강한 비',\n  71: '가벼운 눈', 73: '눈', 75: '강한 눈',\n  80: '소나기', 81: '강한 소나기', 82: '매우 강한 소나기',\n  95: '뇌우', 96: '우박을 동반한 뇌우', 99: '강한 우박을 동반한 뇌우'\n};\n\nconst weather = $('날씨 조회').first().json.current;\nconst weatherDesc = weatherCodeMap[weather.weather_code] || '알 수 없음';\n\nconst newsItems = $('인기 뉴스').all().slice(0, 5);\nconst newsText = newsItems\n  .map((item, i) => `${i + 1}. ${item.json.title}`)\n  .join('\\n');\n\nconst today = new Date().toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul' });\n\nconst message = [\n  `📅 ${today} 아침 브리핑`,\n  '',\n  `🌤 오늘의 서울 날씨: ${weatherDesc}, ${weather.temperature_2m}°C (습도 ${weather.relative_humidity_2m}%, 풍속 ${weather.wind_speed_10m}m/s)`,\n  '',\n  `📰 오늘의 인기 뉴스 TOP 5`,\n  newsText\n].join('\\n');\n\nreturn [{ json: { message } }];"
      }
    },
